                                    {subjectsTaughtList.slice(0, 3).join(', ')}
                                    {subjectsTaughtList.length > 3 && ` +${subjectsTaughtList.length - 3}`}
                                </span>
                            ) : (
                                <span className="text-gray-400 italic font-normal">None Assigned</span>
                            )}
                         </div>
                      </div>
                  </Tooltip>
               </CardContent>
            </Card>

          </div>
        </div>
      </div>
    </div>
  )
}

