SELECT 
  (SELECT id FROM classes WHERE name = 'KG 1' LIMIT 1),
  (SELECT id FROM classes WHERE name = 'KG 2' LIMIT 1),
  FALSE
WHERE EXISTS (SELECT 1 FROM classes WHERE name = 'KG 1')
  AND EXISTS (SELECT 1 FROM classes WHERE name = 'KG 2');

