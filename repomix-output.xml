                    <div className="text-xs text-gray-500">Overall</div>
                    <div className={`font-bold ${previewResult.evaluation.overall.passed ? 'text-green-600' : 'text-red-600'}`}>
                      {previewResult.evaluation.overall.passed ? '✓' : '✗'}
