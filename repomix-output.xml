      (entityLabels[log.entity_name]?.toLowerCase().includes(searchTerm.toLowerCase())) ||
      (log.action?.toLowerCase().includes(searchTerm.toLowerCase())) ||
      ((log.profiles?.full_name || 'System').toLowerCase().includes(searchTerm.toLowerCase()))

