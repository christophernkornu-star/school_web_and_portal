                              <span className="text-xs md:text-sm font-medium text-gray-600">Specialization: </span>
                              <span className="text-xs md:text-sm text-gray-800">{teacher.specialization}</span>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                    <Link
                      href={`/admin/teachers/${teacher.teacher_id}`}
