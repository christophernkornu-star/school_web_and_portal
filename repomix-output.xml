  @apply bg-orange-100 text-orange-800;
}

.grade-E, .grade-F {
  @apply bg-red-100 text-red-800;
}

/* Slideshow Animations */
@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-up {
