                {/* Upload Method Toggle */}
                <div className="border-t border-b py-4">
                  <label className="block text-sm font-medium text-gray-700 mb-3">Featured Image</label>
                  <div className="flex space-x-4 mb-4">
                    <button
                      type="button"
                      onClick={() => setUploadMethod('file')}
