  'Orphaned Profile' as issue,
  p.username,
  p.email,
  'Missing teacher record' as problem
FROM profiles p
WHERE p.role = 'teacher'
AND NOT EXISTS (SELECT 1 FROM teachers t WHERE t.profile_id = p.id);

