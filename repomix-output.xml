                    <div className="mt-3 border rounded-lg p-3 bg-gray-50">
                      <p className="text-sm font-medium text-gray-700 mb-2">Preview:</p>
                      <img
                        src={formData.featured_image}
                        alt="Preview"
                        className="w-full h-auto max-h-48 object-contain rounded-lg"
