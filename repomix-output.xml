                          <th className="pb-3 font-semibold text-gray-600 text-right">Balance</th>
                          <th className="pb-3 font-semibold text-gray-600 text-center">Action</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100">
